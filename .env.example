# API server
PORT=3000
HOST=0.0.0.0

# Database (the schema comes from local-env/database/sql/schema.sql)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/find_potential_stock

# Public site origin allowed by CORS. Comma-separate several origins.
CORS_ORIGIN=http://localhost:5173

# Owner session and login protection
SESSION_TTL_MINUTES=30
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW_MINUTES=15
SECURE_COOKIES=false

# Log level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Scheduled scraper. Keep disabled unless you want this process to scrape LIHKG.
SCRAPE_ENABLED=false
SCRAPE_CRON=0 3 * * *
SCRAPE_TIMEZONE=Asia/Hong_Kong
SCRAPE_RUN_ON_START=false
SCRAPE_STALE_MINUTES=240

# Scraper behaviour
SCRAPE_SOURCE=LIHKG
SCRAPE_KEYWORDS=??SCRAPE_LIMIT=10
SCRAPE_SORT=desc_create_time
SCRAPE_DELAY_MS=4000
SCRAPE_TIMEOUT_MINUTES=180
SCRAPE_INCLUDE_OP=false
SCRAPE_OUTPUT_DIR=scrape-output

# Rotating text logs: logs/scraper/log_1.txt, log_2.txt, ...
SCRAPE_LOG_DIR=logs/scraper
SCRAPE_LOG_MAX_BYTES=10485760

# Error alerts. Leave SMTP_HOST empty to skip sending; the run still logs a warning.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=roy2b32@gmail.com
