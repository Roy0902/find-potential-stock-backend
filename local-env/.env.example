# PostgreSQL connection used by `npm run db:setup` and `npm run db:seed`.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/find_potential_stock

# Playwright base URL. Defaults to http://localhost:5173 when unset.
URL=http://localhost:5173

# Set to 1 to let Playwright start the frontend dev server before the tests.
START_WEB_SERVER=1
WEB_SERVER_COMMAND=npm --prefix ../../find-potential-stock-frontend run dev
WEB_SERVER_URL=http://localhost:5173

# Owner login used by `npm run auth:setup` to write playwright/.auth/owner.json.
ADMIN_USERNAME=owner
ADMIN_PASSWORD=change-me
